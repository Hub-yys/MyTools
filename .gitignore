# MyTools 开发环境产物
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
# dist\ 里除了几个打包/发版脚本（它们是源码，不是产物），其余都不进库。
# ⚠ 必须写 dist/* 而不是 dist/ —— 目录被整体忽略之后，里面的 !例外规则不生效，
#   脚本会被静默丢掉（这个坑跟下面 /data/ 那条是同一类）。
dist/*
!dist/build_installer.ps1
!dist/一键打包安装包.bat
# ★ 发版脚本（检查更新那套靠它发 GitHub Release）
!dist/publish_release.ps1

# 用户数据：根目录 data/ 是开发态的可写用户数据目录。
# 里面只有**打包要用的种子 json** 进库（安装包首次运行会把它们拷到用户目录）。
# ⚠ 必须写成 /data/ 而不是 data/ —— 裸 data/ 会忽略**任意层级**的 data 目录，
#   会把 src/core/data/（角色/套装/声骸技能等游戏数据）和
#   src/tools/data/（鸣潮资源库更新工具源码）一起排除掉。
#   2026-09-23 踩过：磁盘上 src/ 有 51 个文件，git 只看见 44 个。
/data/*
!/data/loadouts.json
!/data/tasks.json
!/data/tool_settings.json
!/data/ui_state.json

# ok-ww 运行时写出来的配置（热键 / 角色开关 / 分辨率探测缓存）—— 本机生成，不进库
configs/

# qfluentwidgets 自己写的主题/皮肤配置（config/config.json）。
# ★ 侧栏皮肤功能（2026-10-05）让它在**工作目录**下生成 —— 本机数据，不进库。
#   里面存着 ThemeColor / ThemeMode / 选的皮肤 id。
/config/

# 同上，但这是 **ok-ww 引擎**自己写的那一份（它按自己的工作目录落盘）。
# ⚠ 2026-10-13 发现：跑一次 4C/扫荡就会生成 vendor/okww/config/config.json，
#   内容只有 ThemeColor / ThemeMode（纯本机偏好）。
#   不进库 —— 否则每次跑完都多一条"改了配置"的脏状态。
vendor/okww/config/

# 抓库街区时留下的页面快照（调试产物）
.playwright-cli/

# vendored ok-ww 里的**游戏素材**：48 张逐帧模板图 + 38MB 的 YOLO 声骸模型。
# 都是库洛画面衍生物，与 assets/game/ 同理，不进仓库。
# ⚠ 排除后克隆下来的仓库**跑不了 4C / 声骸工具** —— 需要自行从 ok-ww 上游取回
#   vendor/okww/assets/images/ 与 vendor/okww/assets/echo_model/echo.onnx
#   （来源见 licenses/NOTICES.md 第 1 节）。
vendor/okww/assets/images/
vendor/okww/assets/echo_model/

# 日志
*.log

# 游戏素材：从 wiki 拉的官方美术素材，版权归库洛，不进仓库。
# 占位图可以用 tools/make_placeholders.py 重新生成。
assets/game/

# 安装包自带的壁纸（7 段转好的 VP9 webm，共约 78 MB）
#   同 assets/game/ 的理由：第三方画面衍生物，版权不归我们，不进仓库。
#   打包前跑 tools/prepare_bundled_wallpapers.py 生成（幂等，已存在的会跳过）。
assets/wallpapers/

# 离线依赖缓存与测试截图（本地有用，不进仓库）
wheels/
tests/_shots/

# OCR 模型优化缓存（首次运行会生成，删掉只是下次慢一点）
cache/

# IDE
.idea/
.vscode/

# 系统
Thumbs.db

# ---------------------------------------------------------------------------
# 备份 / 临时改名留下的残留
# ---------------------------------------------------------------------------
# ⚠ 例：``src/core/skins.py.bak_before_remove_themes``、
#   ``vendor/okww/okww/Labels.py.bak``、``coco_annotations.json.bak_pickup``。
#   这些是本地改代码前的快照，不该进库（也没有任何代码 import 它们）。
*.bak
*.bak_*
*.orig

# ---------------------------------------------------------------------------
# ffmpeg / ffprobe（本地二进制，不进库）
# ---------------------------------------------------------------------------
# ⚠ 为什么不提交：``vendor/ffmpeg/ffmpeg.exe`` 108,702,720 字节、
#   ``ffprobe.exe`` 108,486,656 字节 —— **双双超过 GitHub 单文件 100MB 硬限**，
#   推上去会被拒（而且本仓库没有配 Git LFS）。
#
#   运行时怎么找它：见 :func:`src.core.webm_transcode.find_ffmpeg` —
#   ① ``MYTOOLS_FFMPEG`` 环境变量
#   ② ``<资源根>/vendor/ffmpeg/ffmpeg.exe``（就是这里，本地放进来即可）
#   ③ ``<用户数据目录>/tools/ffmpeg.exe``
#   ④ 系统 ``PATH``
#   所以**从源码跑只要把 ffmpeg.exe / ffprobe.exe 丢进 vendor/ffmpeg/ 就行**；
#   拿不到时壁纸页会显示"（无缩略图）"而不是崩。
#
#   获取方式：https://www.gyan.dev/ffmpeg/builds/ 的 release 版，解压后把
#   ``bin/ffmpeg.exe`` 与 ``bin/ffprobe.exe`` 拷进 ``vendor/ffmpeg/``。
/vendor/ffmpeg/*.exe
